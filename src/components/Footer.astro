---
import { SITE } from '@/config';
---

<footer>
  <div class="inner">
    <span>{SITE.author} · {new Date().getFullYear()}</span>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding: 0 1.5rem;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text-secondary);
  }
</style>
